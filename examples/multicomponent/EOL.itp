; EOL — methanol, as a stand-in second parameterized component ("cofactor").
;
; SOFTWARE DEMONSTRATION fixture. Like MTH.itp this is shaped like an
; independent LigParGen export with its OWN [ atomtypes ] block using generic
; local names. Note the DELIBERATE COLLISION: this file's `opls_800` is
; OXYGEN, while MTH.itp's `opls_800` is CARBON. A naive concatenation of the
; two ITPs would silently use one definition for both molecules and produce a
; scientifically wrong system. SimForge namespaces the conflict per component
; (MTH_opls_800 / EOL_opls_800) and records the rename map in provenance.json.
;
; Non-bonded values: opls_154 (OH) / opls_157 (CT) / opls_156 (HC) /
; opls_155 (HO) from OPLS-AA; bonded terms are explicit OPLS/CHARMM22 values.

[ atomtypes ]
;name   at.num  mass      charge  ptype  sigma(nm)   epsilon(kJ/mol)
 opls_800  8    15.99940  0.000   A      3.12000e-01 7.11280e-01   ; O  (collides w/ MTH C)
 opls_801  6    12.01100  0.000   A      3.50000e-01 2.76144e-01   ; C  (collides w/ MTH H)
 opls_802  1     1.00800  0.000   A      2.50000e-01 1.25520e-01   ; H on C
 opls_803  1     1.00800  0.000   A      0.00000e+00 0.00000e+00   ; H on O

[ moleculetype ]
; name  nrexcl
EOL     3

[ atoms ]
;  nr  type      resnr residue atom  cgnr  charge   mass
   1   opls_801  1     EOL     C1    1      0.145   12.01100
   2   opls_802  1     EOL     H1    1      0.040    1.00800
   3   opls_802  1     EOL     H2    1      0.040    1.00800
   4   opls_802  1     EOL     H3    1      0.040    1.00800
   5   opls_800  1     EOL     O1    1     -0.683   15.99940
   6   opls_803  1     EOL     HO    1      0.418    1.00800

[ bonds ]
;  ai  aj  funct  b0(nm)   kb(kJ/mol/nm^2)
   1   2   1      0.10900  284512.0
   1   3   1      0.10900  284512.0
   1   4   1      0.10900  284512.0
   1   5   1      0.14100  267776.0
   5   6   1      0.09450  462750.0

[ angles ]
;  ai  aj  ak  funct  th0(deg)  cth(kJ/mol/rad^2)
   2   1   3   1      107.800   276.144
   2   1   4   1      107.800   276.144
   3   1   4   1      107.800   276.144
   2   1   5   1      109.500   292.880
   3   1   5   1      109.500   292.880
   4   1   5   1      109.500   292.880
   1   5   6   1      108.500   460.240
