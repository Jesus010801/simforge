; MTH — methane, as a stand-in "small-molecule ligand".
;
; This ITP is a SOFTWARE DEMONSTRATION fixture, not a curated scientific
; parameter set. It is deliberately shaped like an independent LigParGen
; export: it carries its OWN [ atomtypes ] block using generic local names
; (opls_800, opls_801). The bonded terms use explicit OPLS-AA/CHARMM22 values
; so the molecule is self-contained (no ffbonded.itp lookup needed).
;
; Non-bonded values: opls_138 (CT) / opls_140 (HC) from OPLS-AA.

[ atomtypes ]
;name   at.num  mass      charge  ptype  sigma(nm)   epsilon(kJ/mol)
 opls_800  6    12.01100  0.000   A      3.50000e-01 2.76144e-01
 opls_801  1     1.00800  0.000   A      2.50000e-01 1.25520e-01

[ moleculetype ]
; name  nrexcl
MTH     3

[ atoms ]
;  nr  type      resnr residue atom  cgnr  charge   mass
   1   opls_800  1     MTH     C1    1     -0.240   12.01100
   2   opls_801  1     MTH     H1    1      0.060    1.00800
   3   opls_801  1     MTH     H2    1      0.060    1.00800
   4   opls_801  1     MTH     H3    1      0.060    1.00800
   5   opls_801  1     MTH     H4    1      0.060    1.00800

[ bonds ]
;  ai  aj  funct  b0(nm)   kb(kJ/mol/nm^2)
   1   2   1      0.10900  284512.0
   1   3   1      0.10900  284512.0
   1   4   1      0.10900  284512.0
   1   5   1      0.10900  284512.0

[ angles ]
;  ai  aj  ak  funct  th0(deg)  cth(kJ/mol/rad^2)
   2   1   3   1      107.800   276.144
   2   1   4   1      107.800   276.144
   2   1   5   1      107.800   276.144
   3   1   4   1      107.800   276.144
   3   1   5   1      107.800   276.144
   4   1   5   1      107.800   276.144
