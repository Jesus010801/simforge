# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg
*.egg-info/
build/
dist/
*.whl
*.tar.gz
.coverage
.pytest_cache/

# ── Virtual environments ────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Agent / tooling scratch ─────────────────────────────────────────────────
.aider*
.antigravitycli/
.claude/settings.local.json
graphify-out/

# ── SimForge runtime artifacts (generated runs) ─────────────────────────────
simforge_runs/
*.log
mdout.mdp
# built-system output dirs from the docs/examples/demo commands
/demo_system/
/example_system/
/multi_system/
/*_system/
/*_campaign/

# ── GROMACS / molecular files ───────────────────────────────────────────────
# Blanket-ignored because build/run output litters the tree with these.
# Committed fixtures, examples and demo inputs are re-included below.
*.tpr
*.xtc
*.edr
*.trr
*.cpt
*.gro
*.top
*.itp
*.ndx

# ── Large / machine-local structures that must never be committed ───────────
GLP-1_R.pdb
configs/GLP-1_R.pdb
configs/hmg.pdb
bilayer_x
bilayer_y:

# ── Local working configs (absolute paths / uncommitted structures) ────────
configs/WT.yaml
configs/test-memb.yaml
configs/glp1r_membrane.yaml
configs/GLP-1_Receptor.yaml
configs/GLP-1_Receptor_tm_aware.yaml

# ── Internal working notes (kept locally, not published) ────────────────────
docs/internal/
docs/FEL/
docs/audits/
/phase*_audit.md
/phase*_failure_audit.md
/WORKTREE_PENDING_*.txt

# ── Re-include committed inputs (must come AFTER the blanket ignores) ───────
!tests/fixtures/**
!examples/**
!demo/**

# ── ...but never re-include caches under those trees ────────────────────────
__pycache__/
*.py[cod]
